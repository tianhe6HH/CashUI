# 复制本文件为 .env 并按需修改
SECRET_KEY=please-change-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 所有账号的默认密码（新建/重置时使用），请设置为你自己的密码
DEFAULT_PASSWORD=请设置你的默认密码
# 是否启用「登录 IP 绑定」：true 开启后，登录 IP 变化会导致令牌失效需重新登录；默认 false 关闭
BIND_CLIENT_IP=false
# 如使用 MySQL 等，修改此处；默认 SQLite
# DATABASE_URL=sqlite:///./cashui.db
